# Copy to .env for local development. Never commit .env — see CLAUDE.md rule 7.
# Real credentials live in GitHub Environment secrets, not in this file.

DATABASE_URL=postgres://cadenceos:cadenceos@localhost:5432/cadenceos_dev?sslmode=disable
PORT=8080

# Injected at deploy time so /healthz can report which commit is actually serving.
# The health check asserts on this value.
BUILD_SHA=dev

# Occurrence horizon: how many future planned occurrences to keep per active
# schedule. Spec §5 default is 3.
MATERIALIZE_HORIZON=3

# Auth (spec §4). Both are required and must be at least 32 characters; the service
# refuses to start without them rather than serving every schedule to anyone who asks.
# Generate real values with `openssl rand -base64 48` and keep them in the platform's
# secret store — never in this file, and never the placeholders below.
#
# PORTAL_JWT_SECRET is the HS256 key the WP mu-plugin signs customer tokens with.
# SERVICE_API_KEY is the credential the WP backend presents to create schedules at
# checkout, where there is no customer session to mint a token from.
PORTAL_JWT_SECRET=replace-me-with-a-generated-secret-at-least-32-chars
SERVICE_API_KEY=replace-me-with-a-generated-secret-at-least-32-chars

# The iss and aud a customer token must carry. Checking them stops a token minted for
# another service, or another brand's deployment, from working here.
PORTAL_JWT_ISSUER=cadenceos-portal
PORTAL_JWT_AUDIENCE=cadenceos

# Phase 4 notifications (spec §7). Only cmd/notify needs these -- the main service,
# migrate, materialize and sweep all run without them, so leave them unset unless
# you're running cmd/notify locally.
POSTMARK_API_KEY=
NOTIFICATION_FROM_ADDRESS=
NOTIFICATION_SUPPORT_CONTACT=
