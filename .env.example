# Copy to .env for local development. Never commit .env — see CLAUDE.md rule 7.
# Real credentials live in GitHub Environment secrets, not in this file.

DATABASE_URL=postgres://cadenceos:cadenceos@localhost:5432/cadenceos_dev?sslmode=disable
PORT=8080

# Injected at deploy time so /healthz can report which commit is actually serving.
# The health check asserts on this value.
BUILD_SHA=dev

# Occurrence horizon: how many future planned occurrences to keep per active
# schedule. Spec §5 default is 3.
MATERIALIZE_HORIZON=3
